{
  "name": "trilium-reminder",
  "productName": "Trilium Reminder",
  "version": "0.1.0",
  "description": "Unofficial desktop todo popup backed by a Trilium note",
  "author": "Lukas Barbisch",
  "homepage": "https://github.com/lbarbisch/Trilium_Reminder",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "./out/main/index.js",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "electron-vite build",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "desktopName": "trilium-reminder.desktop"
}
